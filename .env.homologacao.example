# .env do servidor de homologação (fatia 9). Copiar para /var/www/abl-prestadores/shared/.env
# e preencher os campos marcados com <...>. Segredos ficam só no servidor, nunca no Git.
# Roteiro completo: docs/infra/homologacao.md

APP_NAME="Gestão de Prestadores"
APP_ENV=homologacao
# Gerar no servidor: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://<dominio-de-homologacao>
APP_LOCALE=pt-BR
APP_TIMEZONE=America/Sao_Paulo
APP_COR_PRIMARIA="#0d6efd"

# Um arquivo por dia, 14 dias (config/logging.php).
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abl_prestadores
DB_USERNAME=abl_prestadores
DB_PASSWORD=<senha-forte-do-mysql>

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Cookie de sessão só por HTTPS.
SESSION_SECURE_COOKIE=true

# Redis instalado no próprio servidor, escutando só em 127.0.0.1.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=<senha-do-redis>
REDIS_PORT=6379

# SMTP do Brevo. O domínio do remetente precisa de SPF e DKIM (docs/infra/homologacao.md, seção E-mail).
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<login-smtp-do-brevo>
MAIL_PASSWORD=<chave-smtp-do-brevo>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=nao-responda@<dominio-do-remetente>
MAIL_FROM_NAME="${APP_NAME}"

# UAU. Enquanto não houver URL HTTPS, usuário técnico e token, fica UAU_FAKE=true.
# Ao ligar o real: php artisan uau:ping --documento=<cpf de teste> (docs/infra/homologacao.md).
UAU_FAKE=true
UAU_BASE_URL=https://<host>:<porta>/uauAPI/api/v1.0
UAU_LOGIN=<ate-8-caracteres>
UAU_SENHA=<senha>
UAU_TOKEN_INTEGRACAO=<token-de-integracao>
UAU_TIMEOUT=30
UAU_TOKEN_TTL=1800
# UAU_SINCRONIZACAO_HORARIO=05:00

# Administrador criado pelo seed (senha aleatória mostrada uma vez) e usuários de
# homologação, um por perfil: perfil:email separados por vírgula.
ADMIN_EMAIL=<email-do-administrador>
HOMOLOGACAO_USUARIOS="rh:<email>,gestor:<email>,financeiro:<email>,colaborador:<email>"
