# Scheduler do Laravel (fatia 6: conciliação diária com o UAU às 05:00).
# Copiar para /etc/cron.d/abl-prestadores (dono root, permissão 644).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

* * * * * deploy cd /var/www/abl-prestadores && php artisan schedule:run >> /dev/null 2>&1
