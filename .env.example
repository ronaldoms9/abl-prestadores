APP_NAME="Gestão de Prestadores"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8000
APP_LOCALE=pt-BR
APP_TIMEZONE=America/Sao_Paulo
APP_COR_PRIMARIA="#0d6efd"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

FORWARD_DB_PORT=3306
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=docker
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# Redis roda só na rede interna do Docker: o host é o nome do serviço.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# API do UAU (Globaltec). Com UAU_FAKE=true a aplicação usa o cliente falso.
UAU_BASE_URL=https://<host>:<porta>/uauAPI/api/v1.0
UAU_LOGIN=
UAU_SENHA=
UAU_TOKEN_INTEGRACAO=
UAU_TIMEOUT=30
UAU_TOKEN_TTL=1800
UAU_FAKE=true
