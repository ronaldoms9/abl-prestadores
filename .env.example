APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

FORWARD_DB_PORT=3306
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=docker
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Redis roda só na rede interna do Docker: o host é o nome do serviço.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# WAHA — acessível apenas pela rede interna do Docker, nunca publicado.
WAHA_DRIVER=waha
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=
WAHA_HMAC_KEY=
WAHA_ENGINE=NOWEB
WAHA_DEFAULT_INSTANCE=waha-1
WAHA_WEBHOOK_URL="${APP_URL}/api/webhooks/waha"

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODELO_PRINCIPAL=google/gemini-2.5-flash-lite
OPENROUTER_MODELO_RESERVA=openai/gpt-5-nano
OPENROUTER_MODELO_TRANSCRICAO=openai/whisper-large-v3-turbo
