APP_NAME="Gestão de Prestadores"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=8000
APP_LOCALE=pt-BR
APP_TIMEZONE=America/Sao_Paulo
APP_COR_PRIMARIA="#0d6efd"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

FORWARD_DB_PORT=3306
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=docker
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Local: "log" grava os e-mails em storage/logs. Servidor: SMTP do Brevo
# (MAIL_MAILER=smtp, MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587,
# MAIL_ENCRYPTION=tls); as credenciais ficam só no .env do servidor.
MAIL_MAILER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=nao-responda@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Redis roda só na rede interna do Docker: o host é o nome do serviço.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# API do UAU (Globaltec). Com UAU_FAKE=true a aplicação usa dados de exemplo.
# Validar no servidor com: php artisan uau:ping
UAU_BASE_URL=https://<host>:<porta>/uauAPI/api/v1.0
UAU_LOGIN=
UAU_SENHA=
UAU_TOKEN_INTEGRACAO=
UAU_TIMEOUT=30
UAU_TOKEN_TTL=1800
UAU_FAKE=true
# Prefixo antes do token no header Authorization (padrão: nenhum, como o UAU aceita).
# UAU_AUTHORIZATION_PREFIXO="Bearer "
# Recusa UAU_BASE_URL em http:// fora do ambiente local. Desligar só em ambiente controlado.
# UAU_EXIGIR_HTTPS=true
# Carga de pessoas por planilha: limite de linhas e consultas por execução do job.
# UAU_PLANILHA_MAX_LINHAS=2000
# UAU_PLANILHA_LOTE=50
